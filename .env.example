# Eksakt — environment variables. Copy to .env.local and fill in.
# Never commit .env.local — it contains secrets.

# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by Next.js server components, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── football-data.org ──────────────────────────────────────────────────────
# From football-data.org dashboard. Required for Edge Functions.
# Set this in Supabase Edge Function secrets, NOT in Next.js — the API key
# never leaves the Edge Function.
#   supabase secrets set FOOTBALL_DATA_API_KEY=...
FOOTBALL_DATA_API_KEY=

# ── Email (prediction reminder emails) ──────────────────────────────────────
# Used only by the send-prediction-reminders Edge Function. The transport is
# chosen at runtime in supabase/functions/_shared/email.ts:
#   • MAILPIT_URL set    → Mailpit (local dev; mail lands in the Supabase inbox)
#   • else RESEND_API_KEY → Resend (production)
# Set these as Edge Function secrets, not Next.js env. In production:
#   supabase secrets set RESEND_API_KEY=re_... \
#                        RESEND_FROM="Eksakt <reminders@your-domain>" \
#                        APP_URL=https://your-app-origin
# Locally, put MAILPIT_URL + RESEND_FROM in supabase/functions/.env instead.
RESEND_API_KEY=
RESEND_FROM=
APP_URL=
# MAILPIT_URL=http://supabase_inbucket_eksakt:8025   # local only
